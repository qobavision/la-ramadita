# Referencia de variables de entorno del backend.
# Spring Boot NO carga este archivo. No copies valores reales aqui.
#
# Configuracion local recomendada (una sola vez):
#   powershell -ExecutionPolicy Bypass -File .\scripts\setup-dev.ps1
#
# Luego cierra y vuelve a abrir la terminal, y arranca:
#   cd backend
#   .\mvnw.cmd spring-boot:run

# Obligatorias para arrancar
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=LaRamadita;encrypt=true;trustServerCertificate=true
DB_USERNAME=<tu_usuario>
DB_PASSWORD=<tu_password>
JWT_SECRET=<generada-localmente>

# Opcional. Si no se define, el backend usa 480 minutos.
JWT_EXPIRATION_MINUTES=480

# Solo la primera vez, si la tabla usuarios esta vacia.
APP_ADMIN_USERNAME=<tu_usuario_admin>
APP_ADMIN_PASSWORD=<tu_password_admin>

# Opcional. Si no se define, el backend usa http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200
